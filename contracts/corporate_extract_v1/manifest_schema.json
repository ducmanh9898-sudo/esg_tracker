{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone Extract delivery manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "files"],
  "properties": {
    "schema_version": {"const": "corporate-extract-manifest-1.0"},
    "batch_id": {"type": "string", "minLength": 1},
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["document_id", "report_year", "report_type", "financial_scope", "pdf_path", "pdf_sha256", "json_path", "json_sha256", "status", "reason"],
        "properties": {
          "document_id": {"type": "string", "minLength": 1},
          "report_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
          "report_type": {"enum": ["ESG", "Financial"]},
          "financial_scope": {"enum": ["Separate", "Consolidated", null]},
          "pdf_path": {"type": ["string", "null"]},
          "pdf_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "json_path": {"type": ["string", "null"]},
          "json_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "status": {"enum": ["delivered", "partial", "unavailable"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
