{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone corporate ESG and financial Extract handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document", "coverage", "records", "issue_log"],
  "properties": {
    "schema_version": {"const": "corporate-extract-1.0"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "company_id", "report_type", "source_document_type", "report_year", "financial_scope", "reporting_entity", "reporting_period_start", "reporting_period_end", "publication_date", "source"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "company_id": {"type": "string", "minLength": 1},
        "report_type": {"enum": ["ESG", "Financial"]},
        "source_document_type": {"enum": ["sustainability_report", "annual_report", "financial_statement"]},
        "report_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "financial_scope": {"enum": ["Separate", "Consolidated", null]},
        "reporting_entity": {"type": ["string", "null"]},
        "reporting_period_start": {"type": ["string", "null"]},
        "reporting_period_end": {"type": ["string", "null"]},
        "publication_date": {"type": ["string", "null"]},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "file_name", "url", "sha256", "page_count", "page_system"],
          "properties": {
            "source_id": {"type": "string", "minLength": 1},
            "file_name": {"type": "string", "minLength": 1},
            "url": {"type": ["string", "null"]},
            "downloaded_at_utc": {"type": ["string", "null"]},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "page_count": {"type": "integer", "minimum": 1},
            "page_system": {"const": "physical_pdf_page_1_based"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"report_type": {"const": "Financial"}}}, "then": {"properties": {"financial_scope": {"enum": ["Separate", "Consolidated"]}, "source_document_type": {"const": "financial_statement"}}}},
        {"if": {"properties": {"report_type": {"const": "ESG"}}}, "then": {"properties": {"financial_scope": {"const": null}}}}
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope_description", "search_status", "pages_checked", "pages_unreadable", "topics_searched", "search_outcomes"],
      "properties": {
        "status": {"enum": ["complete", "partial", "failed"]},
        "scope_description": {"type": "string", "minLength": 1},
        "search_status": {"enum": ["not_searched", "partial_search", "searched", "search_failed"]},
        "pages_checked": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "pages_unreadable": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "topics_searched": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "search_outcomes": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["topic", "status", "pages", "reason"],
            "properties": {
              "topic": {"type": "string", "minLength": 1},
              "status": {"enum": ["not_searched", "searched_not_found", "parse_failure", "extraction_failure", "found"]},
              "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
              "reason": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "issue_log": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue_id", "code", "message", "source_pages", "record_id", "status"],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "source_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "record_id": {"type": ["string", "null"]},
          "status": {"enum": ["open", "resolved", "needs_review"]}
        }
      }
    }
  },
  "$defs": {
    "bbox": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "header": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "text", "physical_page", "row", "column", "bbox"],
      "properties": {
        "role": {"enum": ["year", "unit", "row_label", "caption", "other"]},
        "text": {"type": "string", "minLength": 1},
        "physical_page": {"type": "integer", "minimum": 1},
        "row": {"type": ["integer", "null"]},
        "column": {"type": ["integer", "null"]},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "footnote": {
      "type": "object", "additionalProperties": false,
      "required": ["text", "physical_page", "bbox"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "physical_page": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_sha256", "physical_page", "printed_page", "exact_quote", "context_text", "section", "element_id", "char_start", "char_end", "bbox", "table_id", "row", "column", "headers", "footnotes"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "physical_page": {"type": "integer", "minimum": 1},
        "printed_page": {"type": ["string", "null"]},
        "exact_quote": {"type": "string", "minLength": 1},
        "context_text": {"type": "string", "minLength": 1},
        "section": {"type": ["string", "null"]},
        "element_id": {"type": ["string", "null"]},
        "char_start": {"type": ["integer", "null"], "minimum": 0},
        "char_end": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "table_id": {"type": ["string", "null"]},
        "row": {"type": ["integer", "null"]},
        "column": {"type": ["integer", "null"]},
        "headers": {"type": "array", "items": {"$ref": "#/$defs/header"}},
        "footnotes": {"type": "array", "items": {"$ref": "#/$defs/footnote"}}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "dimension", "record_type", "topic", "metric_id", "metric_label", "metric_definition", "statement", "value", "period", "boundary", "restatement", "evidence", "quality", "comparison_group_id"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "dimension": {"enum": ["E", "S", "G", "X"]},
        "record_type": {"enum": ["claim", "measurement", "target", "policy", "governance_evidence", "financial_measurement"]},
        "topic": {"type": "string", "minLength": 1},
        "metric_id": {"type": ["string", "null"]},
        "metric_label": {"type": "string", "minLength": 1},
        "metric_definition": {"type": ["string", "null"]},
        "statement": {
          "type": "object", "additionalProperties": false,
          "required": ["original_quote", "interpretation", "assertion_kind"],
          "properties": {
            "original_quote": {"type": "string", "minLength": 1},
            "interpretation": {"type": ["string", "null"]},
            "assertion_kind": {"enum": ["reported_result", "target", "plan", "policy", "context", "unknown"]}
          }
        },
        "value": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "original_value", "original_unit", "original_scale", "normalized_value", "normalized_unit", "normalization_factor", "normalization_note"],
          "properties": {
            "status": {"enum": ["available", "missing", "ambiguous", "unknown", "not_applicable"]},
            "original_value": {"type": ["string", "null"]},
            "original_unit": {"type": ["string", "null"]},
            "original_scale": {"type": ["string", "null"]},
            "normalized_value": {"type": ["number", "null"]},
            "normalized_unit": {"type": ["string", "null"]},
            "normalization_factor": {"type": ["number", "null"]},
            "normalization_note": {"type": ["string", "null"]}
          }
        },
        "period": {
          "type": "object", "additionalProperties": false,
          "required": ["observation_year", "observation_start", "observation_end", "measurement_date", "period_type", "year_basis", "baseline_year", "target_deadline"],
          "properties": {
            "observation_year": {"type": ["integer", "null"]},
            "observation_start": {"type": ["string", "null"]},
            "observation_end": {"type": ["string", "null"]},
            "measurement_date": {"type": ["string", "null"]},
            "period_type": {"enum": ["annual", "at_date", "quarter", "half_year", "range", "unknown"]},
            "year_basis": {"enum": ["explicit_quote", "table_header", "same_page_title_and_column", "reviewed_context", "unknown"]},
            "baseline_year": {"type": ["integer", "null"]},
            "target_deadline": {"type": ["string", "null"]}
          }
        },
        "boundary": {
          "type": "object", "additionalProperties": false,
          "required": ["reporting_entity", "consolidation", "scope", "population", "counting_method", "calculation_method", "verified"],
          "properties": {
            "reporting_entity": {"type": ["string", "null"]},
            "consolidation": {"enum": ["Separate", "Consolidated", "not_applicable", "unknown"]},
            "scope": {"type": ["string", "null"]},
            "population": {"type": ["string", "null"]},
            "counting_method": {"type": ["string", "null"]},
            "calculation_method": {"type": ["string", "null"]},
            "verified": {"type": "boolean"}
          }
        },
        "restatement": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "note"],
          "properties": {
            "status": {"enum": ["unknown", "not_restatement_reported", "restated", "ambiguous"]},
            "note": {"type": ["string", "null"]}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "quality": {
          "type": "object", "additionalProperties": false,
          "required": ["extraction_method", "parser_name", "model_id", "prompt_version", "uncertainty", "review_status", "reviewer", "reviewed_at_utc", "review_basis"],
          "properties": {
            "extraction_method": {"enum": ["manual", "rule", "cloud_llm", "chatgpt_assisted", "other"]},
            "parser_name": {"type": ["string", "null"]},
            "model_id": {"type": ["string", "null"]},
            "prompt_version": {"type": ["string", "null"]},
            "uncertainty": {"type": "array", "items": {"type": "string"}},
            "review_status": {"enum": ["pending_human_review", "reviewed", "rejected"]},
            "reviewer": {"type": ["string", "null"]},
            "reviewed_at_utc": {"type": ["string", "null"]},
            "review_basis": {"type": ["string", "null"]}
          }
        },
        "comparison_group_id": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"dimension": {"const": "X"}}}, "then": {"properties": {"record_type": {"const": "financial_measurement"}}}},
        {"if": {"properties": {"record_type": {"const": "financial_measurement"}}}, "then": {"properties": {"dimension": {"const": "X"}}}}
      ]
    }
  }
}
