{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Partial financial table candidates, not verified Graph handoff",
  "type": "object",
  "required": ["schema_version", "parser_version", "graph_ready", "semantic_status", "records", "links", "issues", "source_capture_coverage", "source_artifacts", "source_blocks", "pending", "table_continuations", "notes_coverage", "metadata", "semantic_coverage", "arithmetic_checks", "hierarchy_relationships", "esg_relevant_disclosures"],
  "properties": {
    "schema_version": {"const": "esg-financial-candidates/2.3.0"},
    "parser_version": {"enum": [4, 5, 6, 7]},
    "graph_ready": {"const": false},
    "semantic_status": {"const": "partial"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["record_id", "report_version_id", "record_type", "original_text", "original_cells", "source_refs", "field_sources", "payload", "content_period", "boundary", "missing_fields", "field_status", "data_status", "review"],
        "properties": {
          "record_id": {"type": "string"},
          "record_type": {"enum": ["metric", "measurement", "financial_context"]},
          "domain": {"const": "financial"},
          "original_text": {"type": ["string", "null"]},
          "original_cells": {"type": "array"},
          "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "data_status": {"enum": ["available", "missing", "ambiguous", "unknown"]},
          "review": {"type": "object", "properties": {"status": {"const": "needs_review"}, "verified_fields": {"type": "array", "maxItems": 0}}},
          "missing_fields": {"type": "array", "uniqueItems": true},
          "classification": {"type": "object", "properties": {"pillar": {"const": "unknown"}}}
        },
        "allOf": [
          {
            "if": {"properties": {"record_type": {"const": "measurement"}}},
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "required": ["metric_record_id", "raw_value", "parsed_value", "unit", "currency", "scale", "normalized_value", "row_label_raw", "column_headers_raw", "statement_scope", "period_role", "row_index", "column_index"],
                  "properties": {
                    "raw_value": {"type": "string"},
                    "parsed_value": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
                    "normalized_value": {"type": ["string", "null"]},
                    "unit": {"type": ["string", "null"]},
                    "currency": {"type": ["string", "null"]},
                    "scale": {"enum": [null, "1", "1000", "1000000", "1000000000"]},
                    "statement_scope": {"enum": [null, "separate", "consolidated"]}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"record_type": {"const": "metric"}}},
            "then": {"properties": {"payload": {"required": ["original_name", "code_candidates", "definition", "methodology"]}}}
          },
          {
            "if": {"properties": {"record_type": {"const": "financial_context"}}},
            "then": {"properties": {"payload": {"required": ["statement", "context_type", "context_type_candidates", "notes_title_raw", "section_heading_raw", "statement_scope"]}}}
          }
        ]
      }
    },
    "links": {"type": "array", "items": {"type": "object", "required": ["link_id", "from_id", "to_id", "relation_type", "status"], "properties": {"relation_type": {"const": "metric_measurement"}, "status": {"const": "candidate"}}}},
    "table_continuations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["continuation_id", "from_table_anchor", "to_table_anchor", "status", "review_status", "reasons", "sources"],
        "properties": {
          "status": {"enum": ["rule_matched", "rejected"]},
          "review_status": {"const": "needs_review"},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array"}
        }
      }
    },
    "notes_coverage": {
      "type": "array",
      "items": {"type": "object", "required": ["block_id", "pdf_page", "disposition", "record_id"]}
    },
    "metadata": {"type": "object", "required": ["report_title", "company_name", "statement_scope", "period_start", "period_end", "presentation_currency", "audit_status", "auditor_name", "audit_opinion", "signature_date", "source_pdf", "supplied_metadata"]},
    "semantic_coverage": {"type": "object", "required": ["pages", "tables", "notes", "status", "measurement_mapping_counts"], "properties": {"status": {"const": "partial"}, "pages": {"type": "array"}, "tables": {"type": "array"}}},
    "arithmetic_checks": {"type": "array", "items": {"type": "object", "required": ["check_id", "total_record_id", "operand_record_ids", "status", "source_refs"], "properties": {"status": {"enum": ["pass", "mismatch", "not_checked"]}}}},
    "hierarchy_relationships": {"type": "array"},
    "esg_relevant_disclosures": {"type": "array"},
    "issues": {"type": "array", "items": {"type": "object", "required": ["issue_id", "code", "severity", "status", "source_refs"]}},
    "pending": {"type": "array", "minItems": 1}
  }
}
