{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source capture foundation v2, not semantic Graph handoff",
  "type": "object",
  "required": ["batch", "companies", "reports", "source_artifacts", "source_blocks", "records", "evidence", "links", "coverage", "issues"],
  "additionalProperties": false,
  "properties": {
    "batch": {
      "type": "object",
      "required": ["schema_version", "capture_status", "semantic_status", "graph_ready", "profile_id", "record_count", "block_count", "issue_count"],
      "properties": {
        "schema_version": {"const": "esg-source/2.0.0"},
        "capture_status": {"enum": ["completed", "partial"]},
        "semantic_status": {"const": "not_started"},
        "graph_ready": {"const": false},
        "profile_id": {"type": "string"},
        "record_count": {"const": 0},
        "block_count": {"type": "integer", "minimum": 0},
        "issue_count": {"type": "integer", "minimum": 0}
      }
    },
    "companies": {"type": "array", "maxItems": 0},
    "reports": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["report_version_id", "source_sha256", "source_access", "pdf_page_count", "company_id", "report_scope", "publication_date"],
        "properties": {
          "report_version_id": {"type": "string"},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_access": {"const": "source.pdf"},
          "company_id": {"type": ["string", "null"]},
          "report_scope": {"type": "null"},
          "publication_date": {"type": "null"},
          "pdf_page_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "source_artifacts": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["artifact_id", "path", "sha256", "kind"]}
    },
    "source_blocks": {
      "type": "array",
      "items": {
        "type": "object", "required": ["block_id", "report_version_id", "source", "original_text", "original_cells", "disposition"],
        "properties": {
          "block_id": {"type": "string"},
          "original_text": {"type": ["string", "null"]},
          "original_cells": {"type": ["array", "null"]},
          "disposition": {"const": "pending_semantic_extraction"},
          "source": {
            "type": "object", "required": ["artifact_id", "artifact_sha256", "native_json_pointer", "pdf_page", "printed_page", "native_provenance"],
            "properties": {"pdf_page": {"type": "integer", "minimum": 1}, "printed_page": {"type": "null"}}
          }
        }
      }
    },
    "records": {"type": "array", "maxItems": 0},
    "evidence": {"type": "array", "maxItems": 0},
    "links": {"type": "array", "maxItems": 0},
    "coverage": {
      "type": "object", "required": ["total_pages", "counts", "pages"],
      "properties": {
        "total_pages": {"type": "integer", "minimum": 1},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "pages": {
          "type": "array",
          "items": {
            "type": "object", "required": ["pdf_page", "status", "attempts"],
            "properties": {
              "pdf_page": {"type": "integer", "minimum": 1},
              "status": {"enum": ["pending", "processed", "partial", "failed", "confirmed_blank"]},
              "attempts": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "issues": {"type": "array", "items": {"type": "object", "required": ["issue_id", "record_id", "pdf_page", "code", "status", "details"]}}
  }
}
