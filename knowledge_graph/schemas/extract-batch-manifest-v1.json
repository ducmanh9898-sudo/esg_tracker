{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extract batch manifest v1",
  "type": "object",
  "required": ["schema_version", "batch_id", "files"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch_id": {"type": "string", "minLength": 1},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "company_id", "report_year", "report_type", "reporting_entity", "coverage", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "company_id": {"type": "string", "minLength": 1}, "report_year": {"type": "integer"}, "report_type": {"enum": ["ESG", "Financial"]}, "reporting_entity": {"type": "string", "minLength": 1}, "coverage": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "selection_status": {"type": "string"}}, "additionalProperties": true}}
  },
  "additionalProperties": true
}
