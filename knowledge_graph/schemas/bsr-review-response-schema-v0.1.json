{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BSR stage 17 reviewer responses",
  "type": "object",
  "required": ["schema_version", "packet_id", "responses"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "status", "reviewer", "source_basis", "decision", "notes"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending_adjudication", "accepted", "rejected", "unclear"]},
          "reviewer": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {"type": ["string", "null"]},
              "affiliation": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "source_basis": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_ref_id", "source_document", "pages", "observation"],
              "properties": {
                "source_ref_id": {"type": "string", "minLength": 1},
                "source_document": {"type": "string", "minLength": 1},
                "pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
                "observation": {"type": "string", "minLength": 1},
                "note": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          },
          "decision": {
            "type": "object",
            "required": ["reviewed_outcome", "system_result_assessment", "rationale", "checks"],
            "properties": {
              "reviewed_outcome": {"type": ["string", "null"]},
              "system_result_assessment": {"enum": ["confirmed", "corrected", "inconclusive", null]},
              "rationale": {"type": ["string", "null"]},
              "checks": {
                "type": "object",
                "required": ["original_text", "period", "scope", "reporting_boundary", "metric_definition", "comparability"],
                "properties": {
                  "original_text": {"type": ["string", "null"]},
                  "period": {"type": ["string", "null"]},
                  "scope": {"type": ["string", "null"]},
                  "reporting_boundary": {"type": ["string", "null"]},
                  "metric_definition": {"type": ["string", "null"]},
                  "comparability": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
