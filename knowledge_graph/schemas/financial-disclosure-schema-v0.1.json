{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/esg/financial-disclosure-schema-v0.1.json",
  "title": "Financial disclosure input record",
  "description": "Minimum Extract-to-Graph contract for financial disclosures. It does not imply a rule finding.",
  "type": "object",
  "required": [
    "schema_version", "record_type", "disclosure_id", "company",
    "reporting_period", "item", "scope", "report", "source_location",
    "original_text", "data_status", "synthetic"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "record_type": {"const": "financial_disclosure"},
    "disclosure_id": {"type": "string", "pattern": "^FIN-"},
    "company": {
      "type": "object",
      "required": ["company_id"],
      "properties": {
        "company_id": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reporting_period": {
      "type": "object",
      "required": ["fiscal_year", "period_type", "period_end"],
      "properties": {
        "fiscal_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "period_type": {"enum": ["duration", "instant", "other"]},
        "period_start": {"type": ["string", "null"], "format": "date"},
        "period_end": {"type": "string", "format": "date"},
        "period_label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["item_id", "label"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "statement": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "value": {"type": ["number", "integer", "string", "boolean", "null"]},
    "unit": {"type": ["string", "null"]},
    "scope": {
      "type": "object",
      "required": ["scope_id", "description", "verification_status"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["verified", "unverified"]},
        "entity_set": {"enum": ["parent", "parent_plus_subsidiaries", "unknown"]},
        "source_document": {"type": "string", "minLength": 1},
        "source_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "source_pointer": {"type": "string", "minLength": 1},
        "review_basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "measurement_date": {
      "type": "object",
      "required": ["value", "verification_status"],
      "properties": {
        "value": {"type": ["string", "null"], "format": "date"},
        "verification_status": {"enum": ["verified", "unverified"]},
        "source_document": {"type": "string", "minLength": 1},
        "source_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      },
      "additionalProperties": false
    },
    "employee_definition": {
      "type": "object",
      "required": ["definition_id", "verification_status"],
      "properties": {
        "definition_id": {"type": ["string", "null"]},
        "verification_status": {"enum": ["verified", "unverified"]},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "required": ["report_id", "title", "report_type", "source_uri"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "report_type": {"type": "string", "minLength": 1},
        "source_uri": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "source_location": {
      "type": "object",
      "required": ["source_uri", "location_type", "locator"],
      "properties": {
        "source_uri": {"type": "string", "format": "uri"},
        "location_type": {"enum": ["json_pointer", "table_cell", "section", "other"]},
        "locator": {"type": "string", "minLength": 1},
        "source_pages": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    },
    "original_text": {"type": ["string", "null"]},
    "data_status": {
      "enum": [
        "reported", "uncertain", "not_found_by_extract", "confirmed_not_disclosed"
      ]
    },
    "status_note": {"type": ["string", "null"]},
    "uncertainty": {
      "type": "object",
      "required": ["fields", "reason"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "absence_confirmation": {
      "type": "object",
      "required": ["review_scope", "method", "confirmed_by"],
      "properties": {
        "review_scope": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "confirmed_by": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "synthetic": {"type": "boolean"}
    ,"company_id": {"type": "string", "minLength": 1}
    ,"report_year": {"type": "integer", "minimum": 2000, "maximum": 2100}
    ,"observation_year": {"type": "integer", "minimum": 2000, "maximum": 2100}
    ,"source_report_id": {"type": "string", "minLength": 1}
    ,"source_pages": {
      "type": "array", "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    }
    ,"source_pointer": {"type": "string", "minLength": 1}
    ,"currency": {"type": ["string", "null"]}
    ,"status": {
      "enum": ["reported", "uncertain", "not_found_by_extract", "confirmed_not_disclosed"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"data_status": {"const": "uncertain"}}},
      "then": {"required": ["uncertainty"]}
    },
    {
      "if": {"properties": {"data_status": {"const": "not_found_by_extract"}}},
      "then": {"required": ["status_note"]}
    },
    {
      "if": {"properties": {"data_status": {"const": "confirmed_not_disclosed"}}},
      "then": {"required": ["status_note", "absence_confirmation"]}
    }
  ],
  "additionalProperties": false
}
